# Copia este archivo como .env en el backend y reemplaza los valores de ejemplo.
APP_NAME="Aiko AI Assistant"
APP_VERSION="1.0.0"
ENVIRONMENT=local
DEBUG=false

# Credenciales solo del backend. Nunca las copies al front.
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_USER_ID=user-123
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=12

# Acceso local desde esta computadora.
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080"]
ENABLE_API_DOCS=true

# Selección explícita del modelo. Las claves cloud solo se usan si eliges ese proveedor.
LLM_PROVIDER=ollama
ALLOWED_LLM_PROVIDERS=["ollama"]
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Voz: STT local/backend desactivado por defecto; Whisper requiere clave externa explícita.
STT_PROVIDER=disabled
TTS_PROVIDER=windows
PIPER_MODEL=es_MX-claude-high.onnx
OPENAI_API_KEY=

# Datos locales (se crean al iniciar).
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma
DB_PATH=./data/aiko.db
UPLOAD_DIR=./data/uploads
DOCUMENTS_DIR=./data/documents
ALLOWED_PATHS=["./data/documents","./data/uploads"]
MEMORY_SEARCH_LIMIT=5

# Funciones opcionales; agrega credenciales solo si las vas a usar.
TAVILY_API_KEY=
ENABLE_SEARCH=true
ENABLE_FILESYSTEM=true
ENABLE_DOCUMENT_READER=true
ENABLE_IMAGE_ANALYSIS=true
ENABLE_TRANSLATION=true
DEFAULT_LANGUAGE=es
LOG_LEVEL=INFO

# Sincronización remota opcional. Déjalo vacío para usar solo datos locales.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

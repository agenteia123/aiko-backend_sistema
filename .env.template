# Aiko Backend Configuration

# Application
DEBUG=false
APP_NAME="Aiko AI Assistant"
APP_VERSION="1.0.0"

# API Security
API_KEY=aiko-change-this-in-production-12345
JWT_SECRET=your-jwt-secret-key-change-in-production

# LLM Configuration
# Options: ollama, openai, anthropic, google, grok
LLM_PROVIDER=ollama

# Ollama (Local/Offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=120

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Grok (X.AI)
GROK_API_KEY=

# Analysis Level
# Options: fast, balanced, deep
ANALYSIS_LEVEL=balanced

# Memory Configuration
CHROMA_PERSIST_DIR=./data/chroma
DB_PATH=./data/aiko.db
MEMORY_SEARCH_LIMIT=5

# Voice Configuration
# STT: whisper, google
STT_PROVIDER=whisper
# TTS: piper, google, elevenlabs
TTS_PROVIDER=piper
PIPER_MODEL=en_US-amy-medium

# Tools Configuration
ENABLE_SEARCH=true
ENABLE_FILESYSTEM=true
ENABLE_DOCUMENT_READER=true
ENABLE_IMAGE_ANALYSIS=true
ENABLE_TRANSLATION=true

# Tavily Search API
TAVILY_API_KEY=

# Filesystem Access (comma-separated paths)
ALLOWED_PATHS=./documents,./uploads

# Language
DEFAULT_LANGUAGE=es

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=*

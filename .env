# Aiko Backend Configuration

# Application
DEBUG=false
APP_NAME="Aiko AI Assistant"
APP_VERSION="1.0.0"

# Entorno: local = Ollama primero | production = APIs primero
ENVIRONMENT=local
PREFER_OLLAMA=true
LLM_PROVIDER=ollama

# API Security
API_KEY=aiko-default-key-change-in-production
JWT_SECRET=D7FEHnQqeQNYEzh1fS0ufE6gFWkM_Zq5Mm0yxsFcgd-U_M7LTCd7SxTagK0HnuTE

# Ollama (Local) — cerebro principal en PC
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# --- API keys (opcional en local; solo si Ollama falla) ---
# Regenera las keys en cada consola y pégalas aquí. NO las compartas.

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Grok (X.AI)
GROK_API_KEY=

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Analysis Level
ANALYSIS_LEVEL=balanced

# Memory Configuration
CHROMA_PERSIST_DIR=./data/chroma
DB_PATH=./data/aiko.db
MEMORY_SEARCH_LIMIT=5

# Voice Configuration
STT_PROVIDER=whisper
TTS_PROVIDER=windows
PIPER_MODEL=en_US-amy-medium

# Tools Configuration
ENABLE_SEARCH=true
ENABLE_FILESYSTEM=true
ENABLE_DOCUMENT_READER=true
ENABLE_IMAGE_ANALYSIS=true
ENABLE_TRANSLATION=true

# Tavily Search API (opcional)
TAVILY_API_KEY=

# Filesystem Access (JSON válido)
ALLOWED_PATHS=["C:/Users/User/OneDrive/Documentos", "C:/Users/User/Downloads", "C:/Users/User/Documents", "./documents", "./uploads"]

# Language
DEFAULT_LANGUAGE=es

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["*"]

# Inicio de sesión local
AUTH_USERNAME=alejandro
AUTH_PASSWORD="Al3j1ndr9@"
AUTH_USER_ID=user-123

# Backend local
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080"]
ENABLE_API_DOCS=true

# Usar solo Ollama local
LLM_PROVIDER=ollama
ALLOWED_LLM_PROVIDERS=["ollama"]
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# Voz local
STT_PROVIDER=disabled
TTS_PROVIDER=windows
# Aiko Backend Configuration

# Application
DEBUG=false
APP_NAME="Aiko AI Assistant"
APP_VERSION="1.0.0"

# Entorno: local = Ollama primero | production = APIs primero
ENVIRONMENT=local
PREFER_OLLAMA=true
LLM_PROVIDER=ollama

# API Security
API_KEY=aiko-default-key-change-in-production
JWT_SECRET=your-jwt-secret-key-change-in-production

# Ollama (Local) — cerebro principal en PC
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# --- API keys (opcional en local; solo si Ollama falla) ---
# Regenera las keys en cada consola y pégalas aquí. NO las compartas.

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Grok (X.AI)
GROK_API_KEY=

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Analysis Level
ANALYSIS_LEVEL=balanced

# Memory Configuration
CHROMA_PERSIST_DIR=./data/chroma
DB_PATH=./data/aiko.db
MEMORY_SEARCH_LIMIT=5

# Voice Configuration
STT_PROVIDER=whisper
TTS_PROVIDER=windows
PIPER_MODEL=en_US-amy-medium

# Tools Configuration
ENABLE_SEARCH=true
ENABLE_FILESYSTEM=true
ENABLE_DOCUMENT_READER=true
ENABLE_IMAGE_ANALYSIS=true
ENABLE_TRANSLATION=true

# Tavily Search API (opcional)
TAVILY_API_KEY=

# Filesystem Access (JSON válido)
ALLOWED_PATHS=["C:/Users/User/OneDrive/Documentos", "C:/Users/User/Downloads", "C:/Users/User/Documents", "./documents", "./uploads"]

# Language
DEFAULT_LANGUAGE=es

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["*"]